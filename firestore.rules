rules_version = '2';

// Firestore Security Rules for the loveanddeath-app project.
//
// The Firebase web apiKey in js/firebase.js is a public identifier, not a
// secret — these rules are what actually protect the data. Publish them in
// the Firebase console (Build > Firestore Database > Rules) or via the
// Firebase CLI (`firebase deploy --only firestore:rules`).
//
// Model:
//   likes  { userId, imageFile, likedAt }      — private to each user
//   notes  { userId, imageFile, text, createdAt, displayName } — publicly
//                                                  readable, author-owned

service cloud.firestore {
  match /databases/{database}/documents {

    // Likes: the app only ever reads/writes a user's own likes.
    match /likes/{likeId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Notes: readable by anyone (they render under each image), but only the
    // signed-in author may create or delete their own.
    match /notes/{noteId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
